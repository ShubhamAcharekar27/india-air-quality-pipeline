    cast(reading_time as date) as reading_date,
    pm10,
    pm2_5,
    carbon_monoxide,
    nitrogen_dioxide,
    sulphur_dioxide,
    ozone,
    us_aqi,
    ingestion_date
from ranked
where row_num = 1
  );

